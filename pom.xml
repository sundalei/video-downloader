<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
    <!-- lookup parent from repository -->
  </parent>
  <groupId>com.example</groupId>
  <artifactId>video-downloader</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>video-downloader</name>

  <properties>
    <java.version>21</java.version>
    <spotless.version>3.1.0</spotless.version>
    <commons-codec.version>1.20.0</commons-codec.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>${commons-codec.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>commons-fileupload</groupId>
      <artifactId>commons-fileupload</artifactId>
      <version>1.6.0</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
              <formatJavadoc>true</formatJavadoc>
            </googleJavaFormat>
          </java>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <sortPom/>
          </pom>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>compile</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      RPM packaging (RHEL / Rocky / Alma, el8+). Requires rpmbuild on the build
      host: sudo dnf install rpm-build

      Build: mvn -Prpm -DskipTests package
      Output: target/rpm/video-downloader/RPMS/noarch/video-downloader-*.noarch.rpm
    -->
    <profile>
      <id>rpm</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>rpm-maven-plugin</artifactId>
            <version>2.3.0</version>
            <configuration>
              <name>video-downloader</name>
              <summary>Video Downloader Spring Boot service</summary>
              <description>Spring Boot application packaged as a systemd service. 
                Runs the executable jar under a dedicated, unprivileged system account. 
                Application configuration and secrets are read from /etc/video-downloader/application.yaml.</description>
              <license>Proprietary</license>
              <group>Applications/Internet</group>
              <needarch>noarch</needarch>
              <requires>
                <require>java-21-openjdk-headless</require>
                <require>shadow-utils</require>
                <require>systemd</require>
              </requires>
              <mappings>
                <!-- application dir: own it, keep it traversable (dir needs +x) -->
                <mapping>
                  <directory>/usr/share/video-downloader</directory>
                  <filemode>755</filemode>
                  <username>root</username>
                  <groupname>root</groupname>
                  <directoryIncluded>true</directoryIncluded>
                </mapping>
                <!-- application (fat) jar (file only; dir owned by the mapping above) -->
                <mapping>
                  <directory>/usr/share/video-downloader</directory>
                  <filemode>644</filemode>
                  <username>root</username>
                  <groupname>root</groupname>
                  <directoryIncluded>false</directoryIncluded>
                  <sources>
                    <source>
                      <location>${project.build.directory}/${project.build.finalName}.jar</location>
                      <destination>video-downloader.jar</destination>
                    </source>
                  </sources>
                </mapping>
                <!-- Put just this file into /usr/lib/systemd/system; that folder belongs
                     to systemd and is shared by many packages, so we package the file only,
                     not the folder (directoryIncluded=false). -->
                <mapping>
                  <directory>/usr/lib/systemd/system</directory>
                  <filemode>644</filemode>
                  <username>root</username>
                  <groupname>root</groupname>
                  <directoryIncluded>false</directoryIncluded>
                  <sources>
                    <source>
                      <location>src/main/packaging/video-downloader.service</location>
                    </source>
                  </sources>
                </mapping>
                <!-- external config dir: own it, traversable by the service group (dir needs +x) -->
                <mapping>
                  <directory>/etc/video-downloader</directory>
                  <filemode>750</filemode>
                  <username>root</username>
                  <groupname>video-downloader</groupname>
                  <directoryIncluded>true</directoryIncluded>
                </mapping>
                <!-- external config / secrets, preserved across upgrades (file only) -->
                <mapping>
                  <directory>/etc/video-downloader</directory>
                  <filemode>640</filemode>
                  <username>root</username>
                  <groupname>video-downloader</groupname>
                  <directoryIncluded>false</directoryIncluded>
                  <!-- noreplace: on upgrade, keep the admin's edited file (the real secrets);
                       if the shipped template also changed, the new one is written beside it as
                       application.yaml.rpmnew for optional review, never overwriting the live file. -->
                  <configuration>noreplace</configuration>
                  <sources>
                    <source>
                      <location>src/main/packaging/application.yaml</location>
                    </source>
                  </sources>
                </mapping>
                <!-- Put just this file into /etc/sysconfig; that folder belongs to the OS
                     ('filesystem' package), so we package the file only, not the folder
                     (directoryIncluded=false). -->
                <mapping>
                  <directory>/etc/sysconfig</directory>
                  <filemode>640</filemode>
                  <username>root</username>
                  <groupname>video-downloader</groupname>
                  <directoryIncluded>false</directoryIncluded>
                  <!-- noreplace: same as the /etc config above, an upgrade never overwrites
                       the admin's edited env file. -->
                  <configuration>noreplace</configuration>
                  <sources>
                    <source>
                      <location>src/main/packaging/video-downloader.sysconfig</location>
                      <destination>video-downloader</destination>
                    </source>
                  </sources>
                </mapping>
                <!-- writable working dir (holds posts_retrieval_*.txt) -->
                <mapping>
                  <directory>/var/lib/video-downloader</directory>
                  <filemode>750</filemode>
                  <username>video-downloader</username>
                  <groupname>video-downloader</groupname>
                  <directoryIncluded>true</directoryIncluded>
                </mapping>
                <!-- log dir -->
                <mapping>
                  <directory>/var/log/video-downloader</directory>
                  <filemode>750</filemode>
                  <username>video-downloader</username>
                  <groupname>video-downloader</groupname>
                  <directoryIncluded>true</directoryIncluded>
                </mapping>
              </mappings>
              <preinstallScriptlet>
                <script>getent group video-downloader &gt;/dev/null || groupadd -r video-downloader
getent passwd video-downloader &gt;/dev/null || useradd -r -g video-downloader -d /var/lib/video-downloader -s /sbin/nologin -c "video-downloader service account" video-downloader
exit 0</script>
              </preinstallScriptlet>
              <postinstallScriptlet>
                <script>systemctl daemon-reload &gt;/dev/null 2&gt;&amp;1 || :</script>
              </postinstallScriptlet>
              <preremoveScriptlet>
                <script>if [ "$1" = "0" ]; then systemctl --no-reload disable --now video-downloader.service &gt;/dev/null 2&gt;&amp;1 || :; fi</script>
              </preremoveScriptlet>
              <postremoveScriptlet>
                <script>systemctl daemon-reload &gt;/dev/null 2&gt;&amp;1 || :
if [ "$1" -ge 1 ]; then systemctl try-restart video-downloader.service &gt;/dev/null 2&gt;&amp;1 || :; fi</script>
              </postremoveScriptlet>
            </configuration>
            <executions>
              <execution>
                <id>build-rpm</id>
                <goals>
                  <goal>rpm</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
